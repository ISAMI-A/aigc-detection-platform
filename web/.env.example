# SMTP 发信配置（用于注册/登录/找回密码的邮箱验证码）
# SMTP_PASS 是 QQ 邮箱的「SMTP 授权码」，不是登录密码；请勿提交到仓库
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_account@qq.com
SMTP_PASS=your_smtp_authorization_code
SMTP_FROM=your_account@qq.com
SMTP_SSL=1

# 敏感配置（LLM 预设 api_key）落库加密密钥。
# 注意：一旦已有数据用某个密钥加密，更换后旧数据将无法解密
RS_CRYPTO_KEY=please-change-to-your-own-random-string

# 首次启动自动预置 admin 账号的初始密码；留空则随机生成并打印在后端控制台
ADMIN_INIT_PASSWORD=

# 后端监听地址与端口（默认 127.0.0.1:8000）
WEB_HOST=127.0.0.1
WEB_PORT=8000

# 本地 Ollama 服务地址（遥感核验「本地模型」列表拉取用，默认 http://localhost:11434）
OLLAMA_BASE_URL=http://localhost:11434
